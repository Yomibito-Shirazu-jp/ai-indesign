{
    "manifestVersion": 6,
    "id": "com.bp.aiindesign.local",
    "name": "Ai-inDesign (Local)",
    "version": "1.2.1",
    "main": "index.html",
    "host": [
        {
            "app": "InDesign",
            "minVersion": "18.0"
        }
    ],
    "entrypoints": [
        {
            "type": "panel",
            "id": "mainPanel",
            "label": {
                "default": "Ai-inDesign Local",
                "ja": "AI組版(ローカル)"
            },
            "minimumSize": {
                "width": 280,
                "height": 400
            },
            "preferredDockedSize": {
                "width": 320,
                "height": 500
            }
        }
    ],
    "requiredPermissions": {
        "network": {
            "domains": [
                "ws://127.0.0.1:*",
                "ws://localhost:*",
                "http://127.0.0.1:*",
                "http://localhost:*"
            ]
        },
        "allowCodeGenerationFromStrings": true,
        "localFileSystem": "request",
        "clipboard": "readAndWrite"
    }
}