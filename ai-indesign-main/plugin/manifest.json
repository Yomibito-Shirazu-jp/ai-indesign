{
  "manifestVersion": 5,
  "id": "com.yomibitoshirazujp.ai-indesign",
  "name": "Ai-inDesign",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "ID",
      "minVersion": "18.0"
    },
    {
      "app": "ILST",
      "minVersion": "27.0"
    },
    {
      "app": "PS",
      "minVersion": "24.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "Bridge Panel" }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "ws://127.0.0.1:49300",
        "http://127.0.0.1:49300",
        "ws://localhost:49300",
        "http://localhost:49300",
        "ws://127.0.0.1:49301",
        "http://127.0.0.1:49301",
        "ws://localhost:49301",
        "http://localhost:49301",
        "ws://127.0.0.1:49302",
        "http://127.0.0.1:49302",
        "ws://localhost:49302",
        "http://localhost:49302",
        "ws://127.0.0.1:*",
        "ws://localhost:*"
      ]
    },
    "allowCodeGenerationFromStrings": true
  }
}
