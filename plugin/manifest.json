{
    "manifestVersion": 6,
    "id": "com.yomibitoshirazujp.ai-indesign",
    "name": "Ai-inDesign",
    "version": "1.2.1",
    "main": "index.html",
    "host": [
        { "app": "InDesign", "minVersion": "18.0" }
    ],
    "entrypoints": [
        {
            "type": "panel",
            "id": "mainPanel",
            "label": { "default": "Ai-inDesign", "ja": "AI自動組版アシスタント" },
            "minimumSize": { "width": 280, "height": 400 },
            "preferredDockedSize": { "width": 320, "height": 500 }
        }
    ],
    "requiredPermissions": {
        "network": {
            "domains": [
                "https://ai-indesign-mcp-pdw36wmy5q-an.a.run.app",
                "https://mcp.b-p.co.jp",
                "ws://127.0.0.1:*",
                "ws://localhost:*",
                "http://127.0.0.1:*",
                "http://localhost:*"
            ]
        },
        "allowCodeGenerationFromStrings": true,
        "localFileSystem": "fullAccess",
        "clipboard": "readAndWrite"
    }
}
